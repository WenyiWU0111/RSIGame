# Copy to .env (never committed) and fill in. Nothing else belongs here:
# every other setting lives in configs/default.toml, where it is documented.
#
# One key is enough when one provider serves every role.

OPENROUTER_API_KEY=

# Only if a role is served somewhere else:
# OPENAI_API_KEY=                 # an OpenAI-compatible endpoint
# RSIGAME_JUDGE_API_KEY=          # only if the JUDGE is remote. A local vLLM judge is
#                                 # configured with GAMECRAFT_BENCH_JUDGE_OPENAI_* instead;
#                                 # putting "local" here would send it to OpenRouter.
# RSIGAME_MONITOR_API_KEY=        # the monitor's proxy estimator
# RSIGAME_REPAIR_API_KEY=         # the repair agent
# RSIGAME_GENERATOR_API_KEY=      # initial generation

# Image generation, used by art rounds (the repair agent's generate_game_assets).
# OpenRouter serves the model the paper used:
# OPENGAME_ASSET_MODE=generate
# OPENGAME_IMAGE_PROVIDER=openai-compat
# OPENGAME_IMAGE_BASE_URL=https://openrouter.ai/api/v1
# OPENGAME_IMAGE_MODEL=bytedance-seed/seedream-5-0-lite
# OPENGAME_IMAGE_MIN_PIXELS=3686400      # seedream refuses smaller requests
# OPENGAME_IMAGE_API_KEY=
